{
  "ntfy": {
    "base_url": "https://ntfy.sh",
    "topics": {
      "daily": "mei-daily",
      "alerts": "mei-alerts",
      "digest": "mei-digest",
      "work": "mei-work",
      "weekly": "mei-weekly"
    }
  },
  "paths": {
    "db": "data/mei.sqlite3",
    "log_dir": "logs"
  },
  "price_watch": {
    "enabled": true,
    "items": [
      {
        "name": "MPB Canon EOS R6 (cheapest)",
        "url": "https://www.mpb.com/en-us/product/canon-eos-r6",
        "currency": "USD",
        "regex": "\\$\\s*([0-9,]+(?:\\.[0-9]{2})?)",
        "drop_percent": 3,
        "drop_absolute": 0.01,
        "min_price": 400
      }
    ],
    "template_item": {
      "name": "Example - Canon R6 Body Used",
      "url": "https://example.com/product-page",
      "currency": "USD",
      "regex": "\\$\\s*([0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2})?)",
      "drop_percent": 5,
      "drop_absolute": 100
    }
  }
}
