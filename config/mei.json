{
  "ntfy": {
    "base_url": "https://ntfy.sh",
    "topics": {
      "daily": "mei-daily",
      "alerts": "mei-alerts",
      "digest": "mei-digest",
      "work": "mei-work",
      "weekly": "mei-weekly"
    }
  },
  "rss_digest": {
  "enabled": true,
  "max_items": 4,
  "max_per_feed": 1,
  "feeds": [
    { "name": "Reuters Tech", "url": "https://feeds.reuters.com/reuters/technologyNews" },
    { "name": "Krebs on Security", "url": "https://krebsonsecurity.com/feed/" },
    { "name": "CISA Advisories", "url": "https://www.cisa.gov/cybersecurity-advisories/all.xml" },
    { "name": "Defense One", "url": "https://www.defenseone.com/rss/all/" },
    { "name": "Reuters World", "url": "https://feeds.reuters.com/Reuters/worldNews" },
    { "name": "FT Markets", "url": "https://www.ft.com/markets?format=rss" },
    { "name": "MPB Camera Market", "url": "https://www.mpb.com/en-us/content/rss" },
    { "name": "Ars Technica", "url": "https://feeds.arstechnica.com/arstechnica/index" }
  ]
},
  "paths": {
    "db": "data/mei.sqlite3",
    "log_dir": "logs"
  },
  "price_watch": {
    "enabled": true,
    "items": [
      {
        "name": "MPB Canon EOS R6 (cheapest)",
        "url": "https://www.mpb.com/en-us/product/canon-eos-r6",
        "currency": "USD",
        "regex": "\\$\\s*([0-9,]+(?:\\.[0-9]{2})?)",
        "drop_percent": 3,
        "drop_absolute": 50,
        "min_price": 700,
        "debug_prices": false
      }
    ],
    "template_item": {
      "name": "Example - Canon R6 Body Used",
      "url": "https://example.com/product-page",
      "currency": "USD",
      "regex": "\\$\\s*([0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{2})?)",
      "drop_percent": 5,
      "drop_absolute": 100,
      "debug_prices": false
    }
  }
}
